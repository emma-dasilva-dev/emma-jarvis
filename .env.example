# Copy this file to .env and customize your local installation.
# Never commit .env or real credentials.
JARVIS_USER_NAME=
JARVIS_COMMAND_LANGUAGE=fr-FR
JARVIS_INPUT_DEVICE=
JARVIS_PROJECT_PATH=

# Optional: ElevenLabs voice for spoken greetings and dynamic responses.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Only enable this if you intentionally want the original prerecorded greeting,
# which may mention the original developer by name.
JARVIS_USE_LEGACY_GREETING_AUDIO=false
